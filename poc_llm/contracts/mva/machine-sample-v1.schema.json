{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:m4b-mva:machine-sample:v1",
  "title": "M4B-MVA sanitized machine sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "cycle_id", "mode", "case_id", "session_id", "turn_id",
    "utc_start", "monotonic_start_s", "monotonic_end_s", "implementation_sha",
    "identity", "platform", "command", "process", "timing_ms", "token_metrics",
    "resources", "terminal", "cleanup", "scope", "raw_sanitized_log_path", "missing_reasons"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": ["string", "null"]},
    "mode": {"enum": ["none", "once", "selected_baseline", "capacity_test"]},
    "case_id": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"]},
    "turn_id": {"type": ["integer", "null"], "minimum": 1},
    "utc_start": {"type": "string", "format": "date-time"},
    "monotonic_start_s": {"type": "number", "minimum": 0},
    "monotonic_end_s": {"type": "number", "minimum": 0},
    "implementation_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "surface_sha256", "profile_sha256", "semantic_schema_sha256", "wire_schema_sha256", "config_sha256", "model_sha256", "runtime_sha256", "audio_sha256"],
      "properties": {
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "wire_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audio_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "os", "architecture", "python", "backend", "threads"],
      "properties": {
        "hardware": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"const": "aarch64"},
        "python": {"type": "string", "minLength": 1},
        "backend": {"const": "CPU"},
        "threads": {"const": 4}
      }
    },
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "exit_code", "status", "child_generation", "owner_pid_set"],
      "properties": {
        "start_utc": {"type": "string", "format": "date-time"},
        "end_utc": {"type": ["string", "null"], "format": "date-time"},
        "exit_code": {"type": ["integer", "null"]},
        "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "Blocked"]},
        "child_generation": {"type": ["integer", "null"], "minimum": 1},
        "owner_pid_set": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "timing_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "open", "ttft", "runtime_ttc", "caller_ttc", "close", "speech_end_to_audible_onset"],
      "properties": {
        "ready": {"type": ["number", "null"], "minimum": 0},
        "open": {"type": ["number", "null"], "minimum": 0},
        "ttft": {"type": ["number", "null"], "minimum": 0},
        "runtime_ttc": {"type": ["number", "null"], "minimum": 0},
        "caller_ttc": {"type": ["number", "null"], "minimum": 0},
        "close": {"type": ["number", "null"], "minimum": 0},
        "speech_end_to_audible_onset": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "token_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_user", "rendered", "incremental", "kv", "output"],
      "properties": {
        "new_user": {"type": ["integer", "null"], "minimum": 0},
        "rendered": {"type": ["integer", "null"], "minimum": 0},
        "incremental": {"type": ["integer", "null"], "minimum": 0},
        "kv": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_pss_mib", "owner_rss_mib", "mem_total_mib", "mem_available_mib", "system_used_mib", "swap_used_kib", "temperature_c", "throttled", "oom_or_kernel_fault"],
      "properties": {
        "owner_pss_mib": {"type": ["number", "null"], "minimum": 0},
        "owner_rss_mib": {"type": ["number", "null"], "minimum": 0},
        "mem_total_mib": {"type": ["number", "null"], "minimum": 0},
        "mem_available_mib": {"type": ["number", "null"], "minimum": 0},
        "system_used_mib": {"type": ["number", "null"], "minimum": 0},
        "swap_used_kib": {"type": ["integer", "null"], "minimum": 0},
        "temperature_c": {"type": ["number", "null"]},
        "throttled": {"type": ["string", "null"]},
        "oom_or_kernel_fault": {"type": ["boolean", "null"]}
      }
    },
    "terminal": {"type": ["string", "null"]},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owners_absent", "alsa_owners_zero"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "owners_absent": {"type": ["boolean", "null"]},
        "alsa_owners_zero": {"type": ["boolean", "null"]}
      }
    },
    "scope": {"enum": ["llm_subsystem", "m4_e2e"]},
    "raw_sanitized_log_path": {"type": ["string", "null"]},
    "missing_reasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
