{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:m1:protocol-frame:arm64:1.0",
  "oneOf":[
    {"$ref":"#/$defs/ready"},{"$ref":"#/$defs/generate"},{"$ref":"#/$defs/result"},
    {"$ref":"#/$defs/cancel"},{"$ref":"#/$defs/cancelled"},{"$ref":"#/$defs/error"},
    {"$ref":"#/$defs/shutdown"},{"$ref":"#/$defs/shutdown_ack"}
  ],
  "$defs":{
    "version":{"const":"snowboard.llm/1"},
    "request_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "ready":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version","state","identity"],
      "properties":{
        "type":{"const":"READY"},"protocol_version":{"$ref":"#/$defs/version"},"state":{"const":"READY"},
        "identity":{
          "type":"object","additionalProperties":false,
          "required":["candidate_id","pairing_revision","platform","runtime_sha256","model_sha256","config_sha256"],
          "properties":{
            "candidate_id":{"type":"string","pattern":"^CAND-[A-Z0-9-]+$"},
            "pairing_revision":{"type":"string","minLength":1},
            "platform":{"const":"ubuntu-aarch64"},
            "runtime_sha256":{"$ref":"#/$defs/sha"},"model_sha256":{"$ref":"#/$defs/sha"},
            "config_sha256":{"$ref":"#/$defs/sha"}
          }
        }
      }
    },
    "generate":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version","request_id","input"],
      "properties":{"type":{"const":"GENERATE"},"protocol_version":{"$ref":"#/$defs/version"},"request_id":{"$ref":"#/$defs/request_id"},"input":{"$ref":"urn:snowboard:llm-poc:m1:prompt-input:2.0"}}
    },
    "result":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version","request_id","response","state"],
      "properties":{"type":{"const":"RESULT"},"protocol_version":{"$ref":"#/$defs/version"},"request_id":{"$ref":"#/$defs/request_id"},"response":{"$ref":"urn:snowboard:llm-poc:m1:response:2.0"},"metrics":{"$ref":"#/$defs/metrics"},"state":{"const":"READY"}}
    },
    "metrics":{"type":"object","additionalProperties":false,"required":["init_ms","ttft_ms","prefill_tokens","prefill_tokens_per_second","decode_tokens","decode_tokens_per_second","kv_tokens"],"properties":{"init_ms":{"type":"number","minimum":0},"ttft_ms":{"type":"number","minimum":0},"prefill_tokens":{"type":"integer","minimum":0},"prefill_tokens_per_second":{"type":"number","minimum":0},"decode_tokens":{"type":"integer","minimum":0},"decode_tokens_per_second":{"type":"number","minimum":0},"kv_tokens":{"type":"integer","minimum":0}}},
    "cancel":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version","request_id"],
      "properties":{"type":{"const":"CANCEL"},"protocol_version":{"$ref":"#/$defs/version"},"request_id":{"$ref":"#/$defs/request_id"}}
    },
    "cancelled":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version","request_id","state"],
      "properties":{"type":{"const":"CANCELLED"},"protocol_version":{"$ref":"#/$defs/version"},"request_id":{"$ref":"#/$defs/request_id"},"state":{"const":"READY"}}
    },
    "error":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version","request_id","code","state"],
      "properties":{"type":{"const":"ERROR"},"protocol_version":{"$ref":"#/$defs/version"},"request_id":{"$ref":"#/$defs/request_id"},"code":{"enum":["BUSY","INVALID_REQUEST","TIMEOUT","GENERATION_FAILED","CANCEL_FAILED","PROTOCOL_ERROR"]},"state":{"enum":["READY","GENERATING","FATAL"]}},
      "allOf":[
        {"if":{"properties":{"code":{"const":"BUSY"}}},"then":{"properties":{"state":{"const":"GENERATING"}}}},
        {"if":{"properties":{"code":{"const":"INVALID_REQUEST"}}},"then":{"properties":{"state":{"enum":["READY","GENERATING"]}}}},
        {"if":{"properties":{"code":{"enum":["TIMEOUT","GENERATION_FAILED"]}}},"then":{"properties":{"state":{"const":"READY"}}}},
        {"if":{"properties":{"code":{"enum":["CANCEL_FAILED","PROTOCOL_ERROR"]}}},"then":{"properties":{"state":{"const":"FATAL"}}}}
      ]
    },
    "shutdown":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version"],
      "properties":{"type":{"const":"SHUTDOWN"},"protocol_version":{"$ref":"#/$defs/version"}}
    },
    "shutdown_ack":{
      "type":"object","additionalProperties":false,
      "required":["type","protocol_version"],
      "properties":{"type":{"const":"SHUTDOWN_ACK"},"protocol_version":{"$ref":"#/$defs/version"}}
    }
  }
}
