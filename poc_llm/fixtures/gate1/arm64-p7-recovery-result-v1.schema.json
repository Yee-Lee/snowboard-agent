{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://snowboard.local/gate1/arm64-p7-recovery-result-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["packet_id","execution_sha","candidate_id","platform","result","identity","isolation","p6","level2","rebuild","stderr","violations"],
  "allOf":[
    {
      "oneOf":[
        {
          "properties":{
            "p6":{"properties":{"terminal":{"const":"CANCELLED"},"disposition":{"const":"PASS"}}},
            "level2":{"properties":{"simulated_unresponsive":{"const":true}}}
          }
        },
        {
          "properties":{
            "p6":{"properties":{"terminal":{"const":"TIMEOUT"},"elapsed_ms":{"const":500},"disposition":{"const":"CONDITIONAL_ESCALATION"}}},
            "level2":{"properties":{"simulated_unresponsive":{"const":false}}}
          }
        }
      ]
    }
  ],
  "properties":{
    "packet_id":{"const":"G1-ARM64-P7-RECOVERY-001"},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_id":{"type":"string","minLength":1},
    "platform":{"const":"ubuntu-aarch64"},
    "result":{"const":"PASS"},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["lock_sha256","manifest_sha256","config_sha256","runtime_sha256","model_sha256","runner_sha256","adapter_sha256"],
      "properties":{
        "lock_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},
        "config_sha256":{"$ref":"#/$defs/sha256"},"runtime_sha256":{"$ref":"#/$defs/sha256"},
        "model_sha256":{"$ref":"#/$defs/sha256"},"runner_sha256":{"$ref":"#/$defs/sha256"},
        "adapter_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "isolation":{
      "type":"object","additionalProperties":false,
      "required":["network_namespace","ipv4_routes_present","ipv6_non_loopback_routes_present"],
      "properties":{
        "network_namespace":{"type":"string","pattern":"^net:\\[[0-9]+\\]$"},
        "ipv4_routes_present":{"const":false},"ipv6_non_loopback_routes_present":{"const":false}
      }
    },
    "p6":{
      "type":"object","additionalProperties":false,
      "required":["terminal","elapsed_ms","disposition"],
      "properties":{
        "terminal":{"enum":["CANCELLED","TIMEOUT"]},
        "elapsed_ms":{"type":"number","minimum":0},
        "disposition":{"enum":["PASS","CONDITIONAL_ESCALATION"]}
      }
    },
    "level2":{
      "type":"object","additionalProperties":false,
      "required":["simulated_unresponsive","cleanup"],
      "properties":{
        "simulated_unresponsive":{"type":"boolean"},
        "cleanup":{"$ref":"#/$defs/level2_cleanup"}
      }
    },
    "rebuild":{
      "type":"object","additionalProperties":false,
      "required":["ready","startup_ms","generate_terminal","shutdown_ack","cleanup"],
      "properties":{
        "ready":{"const":true},"startup_ms":{"type":"number","minimum":0,"maximum":10000},
        "generate_terminal":{"const":"RESULT"},"shutdown_ack":{"const":true},
        "cleanup":{"$ref":"#/$defs/clean_cleanup"}
      }
    },
    "stderr":{
      "type":"object","additionalProperties":false,"required":["original","rebuild"],
      "properties":{"original":{"$ref":"#/$defs/stderr"},"rebuild":{"$ref":"#/$defs/stderr"}}
    },
    "violations":{"type":"array","maxItems":0}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stderr":{
      "type":"object","additionalProperties":false,"required":["bytes","sha256"],
      "properties":{"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}
    },
    "level2_cleanup":{
      "type":"object","additionalProperties":false,
      "required":["exit_code","waited","term_sent","kill_sent","process_group_absent"],
      "properties":{
        "exit_code":{"type":"integer"},"waited":{"const":true},"term_sent":{"const":true},
        "kill_sent":{"type":"boolean"},"process_group_absent":{"const":true}
      }
    },
    "clean_cleanup":{
      "type":"object","additionalProperties":false,
      "required":["exit_code","waited","term_sent","kill_sent","process_group_absent"],
      "properties":{
        "exit_code":{"const":0},"waited":{"const":true},"term_sent":{"const":false},
        "kill_sent":{"const":false},"process_group_absent":{"const":true}
      }
    }
  }
}
