{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate1:candidate:arm64:1.0",
  "type":"object","additionalProperties":false,
  "required":["candidate_id","pairing_revision","logical_runtime","model","configs","quantization","license","offline","acquisition_manifest","commands"],
  "properties":{
    "candidate_id":{"type":"string","pattern":"^CAND-[A-Z0-9-]+$"},"pairing_revision":{"type":"string","minLength":1},
    "logical_runtime":{"$ref":"#/$defs/logical"},"model":{"$ref":"#/$defs/artifact"},
    "configs":{"type":"object","additionalProperties":false,"required":["ubuntu-aarch64"],"properties":{"ubuntu-aarch64":{"$ref":"#/$defs/path_sha"}}},
    "quantization":{"type":"string","minLength":1},"license":{"type":"string","minLength":1},"offline":{"const":true},
    "acquisition_manifest":{"$ref":"#/$defs/path_sha"},
    "commands":{"type":"object","additionalProperties":false,"required":["ubuntu-aarch64"],"properties":{"ubuntu-aarch64":{"$ref":"#/$defs/command"}}}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"path_sha":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}},"artifact":{"type":"object","additionalProperties":false,"required":["name","version","path","sha256"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}},"logical":{"type":"object","additionalProperties":false,"required":["name","version","source_sha256","license"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"source_sha256":{"$ref":"#/$defs/sha"},"license":{"type":"string","minLength":1}}},"command":{"type":"object","additionalProperties":false,"required":["argv","sha256"],"properties":{"argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"sha256":{"$ref":"#/$defs/sha"}}}}
}
