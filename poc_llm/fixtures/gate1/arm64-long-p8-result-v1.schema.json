{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://snowboard.local/gate1/arm64-long-p8-result-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["packet_id","execution_sha","candidate_id","platform","result","identity","isolation","long_prompt","p5","p8","lifecycle","cleanup","stderr","violations"],
  "properties":{
    "packet_id":{"const":"G1-ARM64-LONG-P8-001"},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_id":{"type":"string","minLength":1},
    "platform":{"const":"ubuntu-aarch64"},
    "result":{"const":"INCONCLUSIVE"},
    "identity":{"$ref":"#/$defs/identity"},
    "isolation":{"$ref":"#/$defs/isolation"},
    "long_prompt":{
      "type":"object","additionalProperties":false,
      "required":["baseline","long","prefill_increased","within_input_envelope","result"],
      "properties":{
        "baseline":{"$ref":"#/$defs/sample"},"long":{"$ref":"#/$defs/sample"},
        "prefill_increased":{"const":true},"within_input_envelope":{"const":true},
        "result":{"const":"PASS"}
      }
    },
    "p5":{
      "type":"object","additionalProperties":false,
      "required":["disposition","reason","generate_timeout_ms","maximum_observed_wall_ms"],
      "properties":{
        "disposition":{"const":"INCONCLUSIVE"},
        "reason":{"const":"FIXED_16_OUTPUT_ENVELOPE_DID_NOT_TRIGGER_15S_TIMEOUT"},
        "generate_timeout_ms":{"const":15000},
        "maximum_observed_wall_ms":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":14500}
      }
    },
    "p8":{
      "type":"object","additionalProperties":false,
      "required":["turns","response_hash_stable","prefill_tokens_stable","decode_tokens_stable","kv_tokens_stable","result"],
      "properties":{
        "turns":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"#/$defs/sequenced_sample"}},
        "response_hash_stable":{"const":true},"prefill_tokens_stable":{"const":true},
        "decode_tokens_stable":{"const":true},"kv_tokens_stable":{"const":true},
        "result":{"const":"PASS"}
      }
    },
    "lifecycle":{
      "type":"object","additionalProperties":false,"required":["ready","shutdown_ack"],
      "properties":{"ready":{"const":true},"shutdown_ack":{"const":true}}
    },
    "cleanup":{"$ref":"#/$defs/cleanup"},"stderr":{"$ref":"#/$defs/stderr"},
    "violations":{"type":"array","maxItems":0}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["lock_sha256","manifest_sha256","config_sha256","runtime_sha256","model_sha256","runner_sha256","adapter_sha256"],
      "properties":{
        "lock_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},
        "config_sha256":{"$ref":"#/$defs/sha256"},"runtime_sha256":{"$ref":"#/$defs/sha256"},
        "model_sha256":{"$ref":"#/$defs/sha256"},"runner_sha256":{"$ref":"#/$defs/sha256"},
        "adapter_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "isolation":{
      "type":"object","additionalProperties":false,
      "required":["network_namespace","ipv4_routes_present","ipv6_non_loopback_routes_present"],
      "properties":{
        "network_namespace":{"type":"string","pattern":"^net:\\[[0-9]+\\]$"},
        "ipv4_routes_present":{"const":false},"ipv6_non_loopback_routes_present":{"const":false}
      }
    },
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["init_ms","ttft_ms","prefill_tokens","prefill_tokens_per_second","decode_tokens","decode_tokens_per_second","kv_tokens"],
      "properties":{
        "init_ms":{"type":"number","minimum":0},"ttft_ms":{"type":"number","minimum":0},
        "prefill_tokens":{"type":"integer","minimum":1,"maximum":128},
        "prefill_tokens_per_second":{"type":"number","exclusiveMinimum":0},
        "decode_tokens":{"type":"integer","minimum":1,"maximum":16},
        "decode_tokens_per_second":{"type":"number","exclusiveMinimum":0},
        "kv_tokens":{"type":"integer","minimum":1}
      }
    },
    "sample":{
      "type":"object","additionalProperties":false,"required":["wall_ms","metrics","response_sha256"],
      "properties":{
        "wall_ms":{"type":"number","exclusiveMinimum":0},"metrics":{"$ref":"#/$defs/metrics"},
        "response_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "sequenced_sample":{
      "type":"object","additionalProperties":false,"required":["sequence","wall_ms","metrics","response_sha256"],
      "properties":{
        "sequence":{"type":"integer","minimum":1,"maximum":5},
        "wall_ms":{"type":"number","exclusiveMinimum":0},"metrics":{"$ref":"#/$defs/metrics"},
        "response_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "cleanup":{
      "type":"object","additionalProperties":false,
      "required":["exit_code","waited","term_sent","kill_sent","process_group_absent"],
      "properties":{"exit_code":{"const":0},"waited":{"const":true},"term_sent":{"const":false},"kill_sent":{"const":false},"process_group_absent":{"const":true}}
    },
    "stderr":{
      "type":"object","additionalProperties":false,"required":["bytes","sha256"],
      "properties":{"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}
    }
  }
}
