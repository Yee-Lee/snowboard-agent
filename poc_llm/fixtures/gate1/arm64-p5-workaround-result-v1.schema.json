{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://snowboard.local/gate1/arm64-p5-workaround-result-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["packet_id","execution_sha","candidate_id","platform","result","authority","contract_p5_disposition","identity","isolation","workaround","lifecycle","cleanup","stderr","violations"],
  "properties":{
    "packet_id":{"const":"G1-ARM64-P5-WORKAROUND-001"},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_id":{"type":"string","minLength":1},
    "platform":{"const":"ubuntu-aarch64"},
    "result":{"const":"INCONCLUSIVE"},
    "authority":{"const":"USER_APPROVED_WORKAROUND_CORE_APPROVAL_PENDING"},
    "contract_p5_disposition":{"const":"INCONCLUSIVE"},
    "identity":{"$ref":"#/$defs/identity"},
    "isolation":{"$ref":"#/$defs/isolation"},
    "workaround":{
      "type":"object","additionalProperties":false,
      "required":["base_generate_timeout_ms","effective_generate_timeout_ms","only_config_delta","terminal","terminal_state","elapsed_ms","observation"],
      "properties":{
        "base_generate_timeout_ms":{"const":15000},
        "effective_generate_timeout_ms":{"const":1000},
        "only_config_delta":{"const":"generate_timeout_ms"},
        "terminal":{"const":"ERROR"},"terminal_state":{"const":"READY"},
        "elapsed_ms":{"type":"number","minimum":1000,"maximum":6000},
        "observation":{"const":"PASS"}
      }
    },
    "lifecycle":{
      "type":"object","additionalProperties":false,"required":["ready","shutdown_ack"],
      "properties":{"ready":{"const":true},"shutdown_ack":{"const":true}}
    },
    "cleanup":{"$ref":"#/$defs/cleanup"},"stderr":{"$ref":"#/$defs/stderr"},
    "violations":{"type":"array","maxItems":0}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["lock_sha256","manifest_sha256","base_config_sha256","effective_config_sha256","runtime_sha256","model_sha256","runner_sha256","workaround_child_sha256","canonical_adapter_sha256"],
      "properties":{
        "lock_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},
        "base_config_sha256":{"$ref":"#/$defs/sha256"},"effective_config_sha256":{"$ref":"#/$defs/sha256"},
        "runtime_sha256":{"$ref":"#/$defs/sha256"},"model_sha256":{"$ref":"#/$defs/sha256"},
        "runner_sha256":{"$ref":"#/$defs/sha256"},"workaround_child_sha256":{"$ref":"#/$defs/sha256"},
        "canonical_adapter_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "isolation":{
      "type":"object","additionalProperties":false,
      "required":["network_namespace","ipv4_routes_present","ipv6_non_loopback_routes_present"],
      "properties":{
        "network_namespace":{"type":"string","pattern":"^net:\\[[0-9]+\\]$"},
        "ipv4_routes_present":{"const":false},"ipv6_non_loopback_routes_present":{"const":false}
      }
    },
    "cleanup":{
      "type":"object","additionalProperties":false,
      "required":["exit_code","waited","term_sent","kill_sent","process_group_absent"],
      "properties":{"exit_code":{"const":0},"waited":{"const":true},"term_sent":{"const":false},"kill_sent":{"const":false},"process_group_absent":{"const":true}}
    },
    "stderr":{
      "type":"object","additionalProperties":false,"required":["bytes","sha256"],
      "properties":{"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}
    }
  }
}
