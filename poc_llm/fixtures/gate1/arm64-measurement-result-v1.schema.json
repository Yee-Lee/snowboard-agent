{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://snowboard.local/gate1/arm64-measurement-result-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["packet_id","execution_sha","candidate_id","platform","result","identity","isolation","sessions","summary","probes","resources","cleanup","stderr","violations"],
  "properties":{
    "packet_id":{"const":"G1-ARM64-MODEL-MEASUREMENT-001"},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_id":{"type":"string","minLength":1},
    "platform":{"const":"ubuntu-aarch64"},"result":{"const":"PASS"},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["lock_sha256","manifest_sha256","config_sha256","runtime_sha256","model_sha256","runner_sha256","adapter_sha256"],
      "properties":{
        "lock_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},
        "config_sha256":{"$ref":"#/$defs/sha256"},"runtime_sha256":{"$ref":"#/$defs/sha256"},
        "model_sha256":{"$ref":"#/$defs/sha256"},"runner_sha256":{"$ref":"#/$defs/sha256"},
        "adapter_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "isolation":{
      "type":"object","additionalProperties":false,
      "required":["network_namespace","ipv4_routes_present","ipv6_non_loopback_routes_present"],
      "properties":{
        "network_namespace":{"type":"string","pattern":"^net:\\[[0-9]+\\]$"},
        "ipv4_routes_present":{"const":false},"ipv6_non_loopback_routes_present":{"const":false}
      }
    },
    "sessions":{
      "type":"array","minItems":10,"maxItems":10,
      "prefixItems":[{"allOf":[{"$ref":"#/$defs/session"},{"type":"object","properties":{"index":{"const":1},"temperature":{"const":"cold"}}}]}],
      "items":{"allOf":[{"$ref":"#/$defs/session"},{"type":"object","properties":{"temperature":{"const":"hot"}}}]}
    },
    "summary":{
      "type":"object","additionalProperties":false,
      "required":["hot_ttft_ms_p50","hot_ttft_ms_p95","hot_wall_ms_p50","hot_wall_ms_p95","hot_prefill_tps_p50","hot_decode_tps_p50","hot_decode_tokens_mean"],
      "properties":{
        "hot_ttft_ms_p50":{"type":"number","minimum":0},"hot_ttft_ms_p95":{"type":"number","minimum":0},
        "hot_wall_ms_p50":{"type":"number","exclusiveMinimum":0},"hot_wall_ms_p95":{"type":"number","exclusiveMinimum":0},
        "hot_prefill_tps_p50":{"type":"number","exclusiveMinimum":0},"hot_decode_tps_p50":{"type":"number","exclusiveMinimum":0},
        "hot_decode_tokens_mean":{"type":"number","minimum":1,"maximum":16}
      }
    },
    "probes":{
      "type":"object","additionalProperties":false,"required":["busy","cancelled","cancel_ms"],
      "properties":{"busy":{"const":true},"cancelled":{"const":true},"cancel_ms":{"type":"number","minimum":0,"maximum":500}}
    },
    "resources":{
      "type":"object","additionalProperties":false,"required":["peak_rss_kib"],
      "properties":{"peak_rss_kib":{"type":"integer","exclusiveMinimum":0}}
    },
    "cleanup":{
      "type":"object","additionalProperties":false,
      "required":["exit_code","waited","term_sent","kill_sent","process_group_absent"],
      "properties":{"exit_code":{"const":0},"waited":{"const":true},"term_sent":{"const":false},"kill_sent":{"const":false},"process_group_absent":{"const":true}}
    },
    "stderr":{
      "type":"object","additionalProperties":false,"required":["bytes","sha256"],
      "properties":{"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}
    },
    "violations":{"type":"array","maxItems":0}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["init_ms","ttft_ms","prefill_tokens","prefill_tokens_per_second","decode_tokens","decode_tokens_per_second","kv_tokens"],
      "properties":{
        "init_ms":{"type":"number","minimum":0},"ttft_ms":{"type":"number","minimum":0},
        "prefill_tokens":{"type":"integer","minimum":1},"prefill_tokens_per_second":{"type":"number","exclusiveMinimum":0},
        "decode_tokens":{"type":"integer","minimum":1,"maximum":16},"decode_tokens_per_second":{"type":"number","exclusiveMinimum":0},
        "kv_tokens":{"type":"integer","minimum":1}
      }
    },
    "session":{
      "type":"object","additionalProperties":false,"required":["index","temperature","wall_ms","metrics"],
      "properties":{
        "index":{"type":"integer","minimum":1,"maximum":10},"temperature":{"enum":["cold","hot"]},
        "wall_ms":{"type":"number","exclusiveMinimum":0},"metrics":{"$ref":"#/$defs/metrics"}
      }
    }
  }
}
