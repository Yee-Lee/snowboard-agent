{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://snowboard.local/gate1/arm64-p4-result-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["packet_id","execution_sha","candidate_id","platform","result","identity","isolation","method","warmups_completed","cold_samples","hot_samples","summary","resources","p4_disposition","lifecycle","cleanup","stderr","violations"],
  "properties":{
    "packet_id":{"const":"G1-ARM64-P4-001"},"execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_id":{"type":"string","minLength":1},"platform":{"const":"ubuntu-aarch64"},
    "result":{"enum":["PASS","Core threshold decision required"]},
    "identity":{"$ref":"#/$defs/identity"},"isolation":{"$ref":"#/$defs/isolation"},
    "method":{
      "type":"object","additionalProperties":false,
      "required":["input_tokens","max_output_tokens","temperature","warmup_count","cold_count","hot_count"],
      "properties":{"input_tokens":{"const":128},"max_output_tokens":{"const":16},"temperature":{"const":0},"warmup_count":{"const":3},"cold_count":{"const":3},"hot_count":{"const":20}}
    },
    "warmups_completed":{"const":3},
    "cold_samples":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/sample"}},
    "hot_samples":{"type":"array","minItems":20,"maxItems":20,"items":{"$ref":"#/$defs/sample"}},
    "summary":{
      "type":"object","additionalProperties":false,"required":["cold","hot"],
      "properties":{"cold":{"$ref":"#/$defs/summary"},"hot":{"$ref":"#/$defs/summary"}}
    },
    "resources":{
      "type":"object","additionalProperties":false,
      "required":["peak_rss_kib","model_bytes","runtime_bytes","combined_artifact_bytes"],
      "properties":{
        "peak_rss_kib":{"type":"integer","exclusiveMinimum":0},"model_bytes":{"type":"integer","exclusiveMinimum":0},
        "runtime_bytes":{"type":"integer","exclusiveMinimum":0},"combined_artifact_bytes":{"type":"integer","exclusiveMinimum":0}
      }
    },
    "p4_disposition":{"enum":["PASS","Core threshold decision required"]},
    "lifecycle":{
      "type":"object","additionalProperties":false,"required":["ready","shutdown_ack"],
      "properties":{"ready":{"const":true},"shutdown_ack":{"const":true}}
    },
    "cleanup":{"$ref":"#/$defs/cleanup"},"stderr":{"$ref":"#/$defs/stderr"},
    "violations":{"type":"array","maxItems":0}
  },
  "allOf":[
    {"oneOf":[
      {"properties":{"result":{"const":"PASS"},"p4_disposition":{"const":"PASS"}}},
      {"properties":{"result":{"const":"Core threshold decision required"},"p4_disposition":{"const":"Core threshold decision required"}}}
    ]}
  ],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["lock_sha256","manifest_sha256","config_sha256","runtime_sha256","model_sha256","runner_sha256","adapter_sha256"],
      "properties":{
        "lock_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},"config_sha256":{"$ref":"#/$defs/sha256"},
        "runtime_sha256":{"$ref":"#/$defs/sha256"},"model_sha256":{"$ref":"#/$defs/sha256"},"runner_sha256":{"$ref":"#/$defs/sha256"},"adapter_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "isolation":{
      "type":"object","additionalProperties":false,
      "required":["network_namespace","ipv4_routes_present","ipv6_non_loopback_routes_present"],
      "properties":{"network_namespace":{"type":"string","pattern":"^net:\\[[0-9]+\\]$"},"ipv4_routes_present":{"const":false},"ipv6_non_loopback_routes_present":{"const":false}}
    },
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["init_ms","ttft_ms","prefill_tokens","prefill_tokens_per_second","decode_tokens","decode_tokens_per_second","kv_tokens"],
      "properties":{
        "init_ms":{"type":"number","minimum":0},"ttft_ms":{"type":"number","minimum":0},"prefill_tokens":{"type":"integer","minimum":1},
        "prefill_tokens_per_second":{"type":"number","exclusiveMinimum":0},"decode_tokens":{"type":"integer","minimum":1,"maximum":16},
        "decode_tokens_per_second":{"type":"number","exclusiveMinimum":0},"kv_tokens":{"type":"integer","minimum":1}
      }
    },
    "sample":{
      "type":"object","additionalProperties":false,"required":["sequence","wall_ms","metrics"],
      "properties":{"sequence":{"type":"integer","minimum":1,"maximum":20},"wall_ms":{"type":"number","exclusiveMinimum":0},"metrics":{"$ref":"#/$defs/metrics"}}
    },
    "summary":{
      "type":"object","additionalProperties":false,
      "required":["wall_ms_p50","wall_ms_p95","ttft_ms_p50","ttft_ms_p95","prefill_tps_p50","prefill_tps_p95","decode_tps_p50","decode_tps_p95"],
      "properties":{
        "wall_ms_p50":{"type":"number","exclusiveMinimum":0},"wall_ms_p95":{"type":"number","exclusiveMinimum":0},
        "ttft_ms_p50":{"type":"number","minimum":0},"ttft_ms_p95":{"type":"number","minimum":0},
        "prefill_tps_p50":{"type":"number","exclusiveMinimum":0},"prefill_tps_p95":{"type":"number","exclusiveMinimum":0},
        "decode_tps_p50":{"type":"number","exclusiveMinimum":0},"decode_tps_p95":{"type":"number","exclusiveMinimum":0}
      }
    },
    "cleanup":{
      "type":"object","additionalProperties":false,"required":["exit_code","waited","term_sent","kill_sent","process_group_absent"],
      "properties":{"exit_code":{"const":0},"waited":{"const":true},"term_sent":{"const":false},"kill_sent":{"const":false},"process_group_absent":{"const":true}}
    },
    "stderr":{
      "type":"object","additionalProperties":false,"required":["bytes","sha256"],
      "properties":{"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}
    }
  }
}
