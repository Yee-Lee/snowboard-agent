{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate1:acquisition:4.0",
  "type":"object","additionalProperties":false,
  "required":["acquisition_id","candidate_id","pairing_revision","logical_runtime","platforms"],
  "properties":{
    "acquisition_id":{"type":"string","pattern":"^ACQ-[A-Z0-9-]+$"},
    "candidate_id":{"type":"string","pattern":"^CAND-[A-Z0-9-]+$"},
    "pairing_revision":{"type":"string","minLength":1},
    "logical_runtime":{
      "type":"object","additionalProperties":false,
      "required":["name","version","source_sha256","license"],
      "properties":{
        "name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},
        "source_sha256":{"$ref":"#/$defs/sha"},"license":{"type":"string","minLength":1}
      }
    },
    "platforms":{
      "type":"object","additionalProperties":false,
      "required":["ubuntu-x86_64","pi-debian13-aarch64"],
      "properties":{
        "ubuntu-x86_64":{"$ref":"#/$defs/platform"},
        "pi-debian13-aarch64":{"$ref":"#/$defs/platform"}
      }
    }
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{
      "type":"object","additionalProperties":false,"required":["path","sha256"],
      "properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}
    },
    "platform":{
      "type":"object","additionalProperties":false,
      "required":["runtime_artifact","dependency_bundle","install_argv","install_argv_sha256"],
      "properties":{
        "runtime_artifact":{"$ref":"#/$defs/artifact"},
        "dependency_bundle":{"$ref":"#/$defs/artifact"},
        "install_argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "install_argv_sha256":{"$ref":"#/$defs/sha"}
      }
    }
  }
}
