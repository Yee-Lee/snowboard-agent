{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate1:candidate:2.0",
  "type":"object","additionalProperties":false,
  "required":["candidate_id","pairing_revision","runtime","model","config","quantization","license","offline","aarch64_compatible","commands"],
  "properties":{
    "candidate_id":{"type":"string","pattern":"^CAND-[A-Z0-9-]+$"},
    "pairing_revision":{"type":"string","minLength":1},
    "runtime":{"$ref":"#/$defs/artifact"},
    "model":{"$ref":"#/$defs/artifact"},
    "config":{"$ref":"#/$defs/artifact"},
    "quantization":{"type":"string","minLength":1},
    "license":{"type":"string","minLength":1},
    "offline":{"const":true},
    "aarch64_compatible":{"const":true},
    "commands":{
      "type":"object","additionalProperties":false,
      "required":["ubuntu-x86_64","ubuntu-aarch64"],
      "properties":{
        "ubuntu-x86_64":{"$ref":"#/$defs/command"},
        "ubuntu-aarch64":{"$ref":"#/$defs/command"}
      }
    }
  },
  "$defs":{
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["name","version","path","sha256"],
      "properties":{
        "name":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "path":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "command":{
      "type":"object","additionalProperties":false,
      "required":["argv","sha256"],
      "properties":{
        "argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
