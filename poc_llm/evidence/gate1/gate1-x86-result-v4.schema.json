{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate1:x86-result:4.0",
  "type":"object","additionalProperties":false,
  "required":["packet_id","run_id","candidate_id","pairing_revision","platform","result","identity","gates","cases","metrics","log_hygiene","cleanup","violations"],
  "properties":{
    "packet_id":{"const":"G1-X86-PI-COMPAT-004"},
    "run_id":{"type":"string","pattern":"^G1-X86-RUN-[A-Z0-9-]+$"},
    "candidate_id":{"type":"string","pattern":"^(CAND-[A-Z0-9-]+|UNBOUND)$"},
    "pairing_revision":{"type":"string","minLength":1},
    "platform":{"const":"ubuntu-x86_64"},
    "result":{"enum":["PASS","FAIL","INCONCLUSIVE","Core threshold decision required"]},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["lock_sha256","manifest_sha256","acquisition_manifest_sha256","command_sha256","logical_runtime_source_sha256","runtime_sha256","dependency_bundle_sha256","model_sha256","config_sha256","catalog_sha256","candidate_schema_sha256","acquisition_schema_sha256","validator_sha256","runner_sha256","runner_core_sha256","result_schema_sha256","x86_result_schema_sha256","pi_result_schema_sha256","selection_schema_sha256","selector_sha256"],
      "properties":{
        "lock_sha256":{"$ref":"#/$defs/sha"},"manifest_sha256":{"$ref":"#/$defs/sha"},
        "acquisition_manifest_sha256":{"$ref":"#/$defs/sha"},"command_sha256":{"$ref":"#/$defs/sha"},
        "logical_runtime_source_sha256":{"$ref":"#/$defs/sha"},"runtime_sha256":{"$ref":"#/$defs/sha"},
        "dependency_bundle_sha256":{"$ref":"#/$defs/sha"},"model_sha256":{"$ref":"#/$defs/sha"},
        "config_sha256":{"$ref":"#/$defs/sha"},"catalog_sha256":{"$ref":"#/$defs/sha"},
        "candidate_schema_sha256":{"$ref":"#/$defs/sha"},"acquisition_schema_sha256":{"$ref":"#/$defs/sha"},
        "validator_sha256":{"$ref":"#/$defs/sha"},"runner_sha256":{"$ref":"#/$defs/sha"},
        "runner_core_sha256":{"$ref":"#/$defs/sha"},"result_schema_sha256":{"$ref":"#/$defs/sha"},
        "x86_result_schema_sha256":{"$ref":"#/$defs/sha"},"pi_result_schema_sha256":{"$ref":"#/$defs/sha"},
        "selection_schema_sha256":{"$ref":"#/$defs/sha"},"selector_sha256":{"$ref":"#/$defs/sha"}
      }
    },
    "gates":{"type":"object"},
    "cases":{"type":"array"},
    "metrics":{"type":"object"},
    "log_hygiene":{"type":"object"},
    "cleanup":{"type":"object"},
    "violations":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"sha":{"type":"string","pattern":"^([0-9a-f]{64}|UNAVAILABLE)$"}}
}
