{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate1:selection:4.0",
  "type":"object","additionalProperties":false,
  "required":["packet_id","selection_cycle_id","stage","result","preselected_candidates","proposed_finalists","rejected_pairings","x86_evidence_count","pi_evidence_count","max_two_enforced","backfill_forbidden","gate2_credit","violations"],
  "properties":{
    "packet_id":{"const":"G1-X86-PI-COMPAT-004"},
    "selection_cycle_id":{"type":"string","pattern":"^G1-CYCLE-[A-Z0-9-]+$"},
    "stage":{"enum":["PRESELECTION","FINAL"]},
    "result":{"enum":["PASS","FAIL","INCONCLUSIVE","Core threshold decision required","PRESELECTED"]},
    "preselected_candidates":{"type":"array","maxItems":2,"items":{"$ref":"#/$defs/candidate"}},
    "proposed_finalists":{"type":"array","maxItems":2,"items":{"$ref":"#/$defs/candidate"}},
    "rejected_pairings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["candidate_id","pairing_revision","reason"],"properties":{"candidate_id":{"type":"string"},"pairing_revision":{"type":"string"},"reason":{"type":"string","minLength":1}}}},
    "x86_evidence_count":{"type":"integer","minimum":0},"pi_evidence_count":{"type":"integer","minimum":0},
    "max_two_enforced":{"const":true},"backfill_forbidden":{"const":true},"gate2_credit":{"const":false},
    "violations":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"candidate":{"type":"object","additionalProperties":false,"required":["candidate_id","pairing_revision","disposition"],"properties":{"candidate_id":{"type":"string"},"pairing_revision":{"type":"string"},"disposition":{"enum":["PASS","Core threshold decision required"]}}}}
}
