{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate1:pi-compat-result:4.0",
  "type":"object","additionalProperties":false,
  "required":["packet_id","test_id","selection_cycle_id","run_id","candidate_id","pairing_revision","platform","result","identity","environment","checks","observations","cleanup","violations"],
  "properties":{
    "packet_id":{"const":"G1-X86-PI-COMPAT-004"},
    "test_id":{"const":"G1-PI-COMPAT-004"},
    "selection_cycle_id":{"type":"string","pattern":"^G1-CYCLE-[A-Z0-9-]+$"},
    "run_id":{"type":"string","pattern":"^G1-PI-RUN-[A-Z0-9-]+$"},
    "candidate_id":{"type":"string","pattern":"^(CAND-[A-Z0-9-]+|UNBOUND)$"},
    "pairing_revision":{"type":"string","minLength":1},
    "platform":{"const":"pi5-4gb-debian13-aarch64"},
    "result":{"enum":["PASS","FAIL","INCONCLUSIVE"]},
    "identity":{"type":"object","additionalProperties":false,"required":["lock_sha256","manifest_sha256","acquisition_manifest_sha256","preselection_sha256","command_sha256","logical_runtime_source_sha256","runtime_sha256","dependency_bundle_sha256","model_sha256","config_sha256","pi_result_schema_sha256","runner_sha256"],"properties":{
      "lock_sha256":{"$ref":"#/$defs/sha"},"manifest_sha256":{"$ref":"#/$defs/sha"},
      "acquisition_manifest_sha256":{"$ref":"#/$defs/sha"},"preselection_sha256":{"$ref":"#/$defs/sha"},
      "command_sha256":{"$ref":"#/$defs/sha"},"logical_runtime_source_sha256":{"$ref":"#/$defs/sha"},
      "runtime_sha256":{"$ref":"#/$defs/sha"},"dependency_bundle_sha256":{"$ref":"#/$defs/sha"},
      "model_sha256":{"$ref":"#/$defs/sha"},"config_sha256":{"$ref":"#/$defs/sha"},
      "pi_result_schema_sha256":{"$ref":"#/$defs/sha"},"runner_sha256":{"$ref":"#/$defs/sha"}
    }},
    "environment":{"type":"object","additionalProperties":false,"required":["git_sha","git_clean","os_id","os_version","machine","mem_total_bytes","network_disabled_proof_sha256","raw_path_reused"],"properties":{
      "git_sha":{"$ref":"#/$defs/sha"},"git_clean":{"type":"boolean"},"os_id":{"type":"string"},
      "os_version":{"type":"string"},"machine":{"type":"string"},"mem_total_bytes":{"type":"integer","minimum":0},
      "network_disabled_proof_sha256":{"$ref":"#/$defs/sha"},"raw_path_reused":{"type":"boolean"}
    }},
    "checks":{"type":"object","additionalProperties":false,"required":["preselected","artifacts","offline_install","runtime_import","runtime_version","model_load","ready","ping","minimal_generation","shutdown","exit","orphan_zero","isolated_cleanup"],"properties":{
      "preselected":{"$ref":"#/$defs/check"},"artifacts":{"$ref":"#/$defs/check"},
      "offline_install":{"$ref":"#/$defs/check"},"runtime_import":{"$ref":"#/$defs/check"},
      "runtime_version":{"$ref":"#/$defs/check"},"model_load":{"$ref":"#/$defs/check"},
      "ready":{"$ref":"#/$defs/check"},"ping":{"$ref":"#/$defs/check"},
      "minimal_generation":{"$ref":"#/$defs/check"},"shutdown":{"$ref":"#/$defs/check"},
      "exit":{"$ref":"#/$defs/check"},"orphan_zero":{"$ref":"#/$defs/check"},
      "isolated_cleanup":{"$ref":"#/$defs/check"}
    }},
    "observations":{"type":"object","additionalProperties":false,"required":["swap_total_bytes","mem_available_before_bytes","mem_available_after_bytes","disk_free_before_bytes","disk_free_after_bytes","elapsed_ms","informational_only"],"properties":{
      "swap_total_bytes":{"type":"integer","minimum":0},"mem_available_before_bytes":{"type":"integer","minimum":0},
      "mem_available_after_bytes":{"type":"integer","minimum":0},"disk_free_before_bytes":{"type":"integer","minimum":0},
      "disk_free_after_bytes":{"type":"integer","minimum":0},"elapsed_ms":{"type":"number","minimum":0},
      "informational_only":{"const":true}
    }},
    "cleanup":{"type":"object","additionalProperties":false,"required":["exit_code","waited","term_sent","kill_sent","process_group_absent","isolated_environment_removed"],"properties":{
      "exit_code":{"type":["integer","null"]},"waited":{"type":"boolean"},"term_sent":{"type":"boolean"},
      "kill_sent":{"type":"boolean"},"process_group_absent":{"type":"boolean"},"isolated_environment_removed":{"type":"boolean"}
    }},
    "violations":{"type":"array","items":{"type":"string"}}
  },
  "allOf":[{"if":{"properties":{"result":{"const":"PASS"}}},"then":{"properties":{
    "environment":{"properties":{"git_clean":{"const":true},"os_id":{"const":"debian"},"os_version":{"const":"13"},"machine":{"const":"aarch64"},"raw_path_reused":{"const":false}}},
    "checks":{"properties":{"preselected":{"const":"PASS"},"artifacts":{"const":"PASS"},"offline_install":{"const":"PASS"},"runtime_import":{"const":"PASS"},"runtime_version":{"const":"PASS"},"model_load":{"const":"PASS"},"ready":{"const":"PASS"},"ping":{"const":"PASS"},"minimal_generation":{"const":"PASS"},"shutdown":{"const":"PASS"},"exit":{"const":"PASS"},"orphan_zero":{"const":"PASS"},"isolated_cleanup":{"const":"PASS"}}},
    "cleanup":{"properties":{"exit_code":{"const":0},"waited":{"const":true},"term_sent":{"const":false},"kill_sent":{"const":false},"process_group_absent":{"const":true},"isolated_environment_removed":{"const":true}}},
    "violations":{"maxItems":0}
  }}}],
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"check":{"enum":["PASS","FAIL","INCONCLUSIVE","Pending"]}}
}
