{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:llm-poc:gate1:result:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "candidate_id", "platform", "result", "cases", "metrics"],
  "properties": {
    "packet_id": {"const": "G1-UBUNTU-PRESCREEN-001"},
    "candidate_id": {"type": "string", "pattern": "^CAND-[A-Z0-9-]+$"},
    "platform": {"enum": ["ubuntu-x86_64", "ubuntu-aarch64"]},
    "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "Blocked", "Core threshold decision required"]},
    "cases": {
      "type": "array",
      "minItems": 60,
      "items": {
        "type": "object",
        "required": ["fixture_id", "repetition", "normalized", "log_forbidden_hits"],
        "properties": {
          "fixture_id": {"type": "string"},
          "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
          "normalized": {"type": "object"},
          "log_forbidden_hits": {"type": "array", "maxItems": 0}
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["ready_ms", "hot_ttft_ms_p95", "hot_tokens_per_second", "peak_rss_bytes", "disk_bytes"],
      "properties": {
        "ready_ms": {"type": "number", "minimum": 0},
        "hot_ttft_ms_p95": {"type": "number", "minimum": 0},
        "hot_tokens_per_second": {"type": "number", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0},
        "disk_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
