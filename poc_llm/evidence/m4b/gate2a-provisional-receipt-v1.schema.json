{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate2a:provisional-receipt:1.0",
  "type":"object","additionalProperties":false,
  "required":["receipt_version","packet_id","candidate_id","candidate_disposition","execution_sha","execution_surface_sha256","gate2a_lock_sha256","candidate_result_sha256","artifact_receipt_sha256","gate1_entry_sha256","p_results","p4_threshold_decision","user_review","core_ack_id","core_ack_required_before_final_delivery","workaround","result"],
  "properties":{
    "receipt_version":{"const":"gate2a-provisional/1"},
    "packet_id":{"const":"G2A-PI-LLM-002"},
    "candidate_id":{"enum":["CAND-LRT-G4E2B-MOBILE-R1","CAND-LRT-Q25-15B-Q8-R1"]},
    "candidate_disposition":{"enum":["NORMAL_FINALIST","USER_CORE_DEFECT_WAIVER"]},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "execution_surface_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gate2a_lock_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "candidate_result_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gate1_entry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "p_results":{
      "type":"object","additionalProperties":false,
      "required":["P1","P2","P3","P4","P5","P6.1","P7.1","P8","P10A","P11","P12"],
      "properties":{
        "P1":{"const":"PASS"},"P2":{"const":"PASS"},"P3":{"const":"PASS"},
        "P4":{"enum":["PASS","CORE_THRESHOLD_ACCEPTED"]},"P5":{"const":"PASS"},
        "P6.1":{"const":"PASS"},"P7.1":{"enum":["PASS","FAIL"]},"P8":{"const":"PASS"},
        "P10A":{"const":"PASS"},"P11":{"const":"PASS"},"P12":{"const":"PASS"}
      }
    },
    "p4_threshold_decision":{"type":["object","null"]},
    "user_review":{
      "type":"object","additionalProperties":false,"required":["approved","review_id"],
      "properties":{"approved":{"const":true},"review_id":{"type":"string","minLength":1}}
    },
    "core_ack_id":{"type":["string","null"],"minLength":1},
    "core_ack_required_before_final_delivery":{"const":true},
    "workaround":{"type":["object","null"]},
    "result":{"const":"PASS"}
  },
  "allOf":[
    {
      "if":{"properties":{"p_results":{"properties":{"P4":{"const":"PASS"}}}}},
      "then":{"properties":{"p4_threshold_decision":{"type":"null"}}}
    },
    {
      "if":{"properties":{"p_results":{"properties":{"P4":{"const":"CORE_THRESHOLD_ACCEPTED"}}}}},
      "then":{"properties":{"p4_threshold_decision":{
        "type":"object","additionalProperties":false,
        "required":["core_decision_id","accepted"],
        "properties":{"core_decision_id":{"type":"string","minLength":1},"accepted":{"const":true}}
      }}}
    },
    {
      "if":{"properties":{"candidate_id":{"const":"CAND-LRT-G4E2B-MOBILE-R1"}}},
      "then":{"properties":{"candidate_disposition":{"const":"NORMAL_FINALIST"},"p_results":{"properties":{"P7.1":{"const":"PASS"}}},"workaround":{"type":"null"}}}
    },
    {
      "if":{"properties":{"candidate_id":{"const":"CAND-LRT-Q25-15B-Q8-R1"}}},
      "then":{"properties":{
        "candidate_disposition":{"const":"USER_CORE_DEFECT_WAIVER"},
        "p_results":{"properties":{"P7.1":{"const":"FAIL"}}},
        "workaround":{
          "type":"object","additionalProperties":false,
          "required":["disposition","accepted_by_user","accepted_by_core","user_decision_id","core_decision_id"],
          "properties":{
            "disposition":{"type":"string","minLength":1},"accepted_by_user":{"const":true},
            "accepted_by_core":{"const":true},"user_decision_id":{"type":"string","minLength":1},
            "core_decision_id":{"type":"string","minLength":1}
          }
        }
      }}
    }
  ]
}
