{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate2b:pi-result:1.0",
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "owner_sample":{"type":"object","additionalProperties":false,"required":["root_pid","root_present","process_count","rss_kib","pss_kib","threads","cpu_ticks"],"properties":{"root_pid":{"type":"integer","minimum":1},"root_present":{"const":true},"process_count":{"type":"integer","minimum":1},"rss_kib":{"type":"integer","minimum":1},"pss_kib":{"type":"integer","minimum":1},"threads":{"type":"integer","minimum":1},"cpu_ticks":{"type":"integer","minimum":0}}},
    "resource_sample":{"type":"object","required":["monotonic_s","mem_total_kib","mem_available_kib","swap_total_kib","system_used_mib","temperature_c","throttled","psi_full_total","owners","unique_process_count"],"properties":{"monotonic_s":{"type":"number","minimum":0},"mem_total_kib":{"type":"integer","minimum":1},"mem_available_kib":{"type":"integer","minimum":1},"swap_total_kib":{"const":0},"system_used_mib":{"type":"number","maximum":3584},"temperature_c":{"type":"number","exclusiveMaximum":80},"throttled":{"const":"throttled=0x0"},"psi_full_total":{"type":"integer","minimum":0},"owners":{"type":"object","additionalProperties":false,"required":["controller","vad","asr","tts","llm"],"properties":{"controller":{"$ref":"#/$defs/owner_sample"},"vad":{"$ref":"#/$defs/owner_sample"},"asr":{"$ref":"#/$defs/owner_sample"},"tts":{"$ref":"#/$defs/owner_sample"},"llm":{"$ref":"#/$defs/owner_sample"}}},"unique_process_count":{"type":"integer","minimum":5},"collection_duration_s":{"type":"number","minimum":0},"session_index":{"type":"integer","minimum":1,"maximum":20}}},
    "owner_peak":{"type":"object","additionalProperties":false,"required":["process_count","rss_mib","pss_mib","threads","cpu_ticks"],"properties":{"process_count":{"type":"integer","minimum":1},"rss_mib":{"type":"number","exclusiveMinimum":0},"pss_mib":{"type":"number","exclusiveMinimum":0},"threads":{"type":"integer","minimum":1},"cpu_ticks":{"type":"integer","minimum":1}}},
    "leak_calculation":{"type":"object","additionalProperties":false,"required":["slope_mib_per_session","late_early_median_delta_mib"],"properties":{"slope_mib_per_session":{"type":"number","maximum":4.0},"late_early_median_delta_mib":{"type":"number","maximum":64.0}}},
    "domain_cleanup":{"type":"object","additionalProperties":false,"required":["root_pid","cooperative_stop","fallback_used","process_group_absent","error_type"],"properties":{"root_pid":{"type":"integer","minimum":1},"cooperative_stop":{"const":true},"fallback_used":{"const":false},"process_group_absent":{"const":true},"error_type":{"type":"null"}}},
    "log_scan":{"type":"object","additionalProperties":false,"required":["passed","scanned_files","static_marker_count","runtime_marker_count"],"properties":{"passed":{"const":true},"scanned_files":{"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["name","sha256"],"properties":{"name":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}}},"static_marker_count":{"const":7},"runtime_marker_count":{"type":"integer","minimum":80}}},
    "session":{
      "type":"object","additionalProperties":false,
      "required":["session_id","audio_fixture_id","tts_fixture_id","vad","asr","llm","tts","timings_ms"],
      "properties":{
        "session_id":{"pattern":"^M4-SESSION-(0[1-9]|1[0-9]|20)$"},
        "audio_fixture_id":{"type":"string","minLength":1},"tts_fixture_id":{"type":"string","minLength":1},
        "vad":{"type":"object","additionalProperties":false,"required":["terminal","bounded_sha256"],"properties":{"terminal":{"const":"SUCCESS"},"bounded_sha256":{"$ref":"#/$defs/sha256"}}},
        "asr":{"type":"object","additionalProperties":false,"required":["terminal","transcript_sha256","latency_ms"],"properties":{"terminal":{"const":"SUCCESS"},"transcript_sha256":{"$ref":"#/$defs/sha256"},"latency_ms":{"type":"number","minimum":0}}},
        "llm":{"type":"object","additionalProperties":false,"required":["terminal","request_id","response_sha256","speech_sha256","prior_marker_leaked","current_marker_present_once","current_trap_absent","metrics"],"properties":{"terminal":{"const":"SUCCESS"},"request_id":{"pattern":"^M4-SESSION-(0[1-9]|1[0-9]|20)$"},"response_sha256":{"$ref":"#/$defs/sha256"},"speech_sha256":{"$ref":"#/$defs/sha256"},"prior_marker_leaked":{"const":false},"current_marker_present_once":{"const":true},"current_trap_absent":{"const":true},"metrics":{"type":"object","required":["prefill_tokens","decode_tokens","kv_tokens","ttft_ms","decode_tokens_per_second"],"properties":{"prefill_tokens":{"type":"integer","minimum":1},"decode_tokens":{"type":"integer","minimum":1,"maximum":64},"kv_tokens":{"type":"integer","minimum":1,"maximum":1024},"ttft_ms":{"type":"number","minimum":0},"decode_tokens_per_second":{"type":"number","exclusiveMinimum":0}}}}},
        "tts":{"type":"object","additionalProperties":false,"required":["terminal","pcm_sha256","sample_count","playback_complete","input_speech_sha256"],"properties":{"terminal":{"const":"SUCCESS"},"pcm_sha256":{"$ref":"#/$defs/sha256"},"sample_count":{"type":"integer","minimum":1},"playback_complete":{"const":true},"input_speech_sha256":{"$ref":"#/$defs/sha256"}}},
        "timings_ms":{"type":"object","additionalProperties":false,"required":["vad","asr","llm","tts_playback","end_to_end"],"properties":{"vad":{"type":"number","minimum":0},"asr":{"type":"number","minimum":0},"llm":{"type":"number","minimum":0},"tts_playback":{"type":"number","minimum":0},"end_to_end":{"type":"number","minimum":0}}}
      }
    },
    "resources_pass":{
      "type":"object","required":["sample_count","peak_system_used_mib","peak_temperature_c","max_sample_start_gap_s","max_collection_duration_s","psi_full_total_delta","oom_kill_delta","owner_sets_complete","cpu_observed_for_all_owners","swap_zero_for_all_samples","throttled_zero_for_all_samples","owner_peaks","leak"],
      "properties":{"sample_count":{"type":"integer","minimum":2},"peak_system_used_mib":{"type":"number","maximum":3584},"peak_temperature_c":{"type":"number","exclusiveMaximum":80},"max_sample_start_gap_s":{"type":"number","maximum":0.5},"max_collection_duration_s":{"type":"number","minimum":0},"psi_full_total_delta":{"const":0},"oom_kill_delta":{"const":0},"owner_sets_complete":{"const":true},"cpu_observed_for_all_owners":{"const":true},"swap_zero_for_all_samples":{"const":true},"throttled_zero_for_all_samples":{"const":true},"owner_peaks":{"type":"object","additionalProperties":false,"required":["controller","vad","asr","tts","llm"],"properties":{"controller":{"$ref":"#/$defs/owner_peak"},"vad":{"$ref":"#/$defs/owner_peak"},"asr":{"$ref":"#/$defs/owner_peak"},"tts":{"$ref":"#/$defs/owner_peak"},"llm":{"$ref":"#/$defs/owner_peak"}}},"leak":{"type":"object","additionalProperties":false,"required":["combined_pss","system_used","per_owner_pss"],"properties":{"combined_pss":{"$ref":"#/$defs/leak_calculation"},"system_used":{"$ref":"#/$defs/leak_calculation"},"per_owner_pss":{"type":"object","additionalProperties":false,"required":["controller","vad","asr","tts","llm"],"properties":{"controller":{"$ref":"#/$defs/leak_calculation"},"vad":{"$ref":"#/$defs/leak_calculation"},"asr":{"$ref":"#/$defs/leak_calculation"},"tts":{"$ref":"#/$defs/leak_calculation"},"llm":{"$ref":"#/$defs/leak_calculation"}}}}}
      }
    },
    "cleanup_pass":{
      "type":"object","required":["reverse_order","process_groups_absent","audio_device_owner_count","llm","domains"],
      "properties":{"reverse_order":{"const":["llm","tts","asr","vad"]},"process_groups_absent":{"type":"object","additionalProperties":false,"required":["vad","asr","tts","llm"],"properties":{"vad":{"const":true},"asr":{"const":true},"tts":{"const":true},"llm":{"const":true}}},"audio_device_owner_count":{"const":0},"llm":{"const":{"exit_code":0,"waited":true,"term_sent":false,"kill_sent":false,"process_group_absent":true}},"domains":{"type":"object","additionalProperties":false,"required":["vad","asr","tts","llm"],"properties":{"vad":{"$ref":"#/$defs/domain_cleanup"},"asr":{"$ref":"#/$defs/domain_cleanup"},"tts":{"$ref":"#/$defs/domain_cleanup"},"llm":{"$ref":"#/$defs/domain_cleanup"}}}}
    },
    "artifact_auth_pass":{
      "type":"object","required":["reused_receipt_sha256","model_sha256","model_size_bytes","full_model_hash_count","metadata_unchanged"],
      "properties":{"reused_receipt_sha256":{"$ref":"#/$defs/sha256"},"model_sha256":{"$ref":"#/$defs/sha256"},"model_size_bytes":{"type":"integer","minimum":1},"full_model_hash_count":{"const":0},"metadata_unchanged":{"const":true}}
    },
    "accepted_audio_pass":{
      "type":"object","required":["audio_completion_sha","audio_tag","audio_tag_object_sha","core_hal_execution_sha","delivery_id","manifest_sha256","status","core_response_id","core_response_sha"],
      "properties":{"audio_completion_sha":{"const":"5694ead4ba6be928fdb4dbdf6da7155b214d72bd"},"audio_tag":{"const":"audio_m4"},"audio_tag_object_sha":{"const":"24b2571a23dde2f77027242b61142b0c1a59924c"},"core_hal_execution_sha":{"const":"6c7fc8ce94c7218e4948b77c2fe79ef6e6cc3dcf"},"delivery_id":{"const":"POC-audio-DEL-2026-001-R1"},"manifest_sha256":{"const":"74e2737f5c965d1691a130176e6e0955dec207134d00686212de4cad60404fad"},"status":{"const":"POC_ACCEPTED_M4_COMPLETE"},"core_response_id":{"const":"RESP-AUDIO-M4-GATE2B-001"},"core_response_sha":{"const":"be19b70b1dd91674e7ff981eb9d6b2dca9741f54"}}
    }
  },
  "type":"object","additionalProperties":false,
  "required":["packet_id","run_id","candidate_id","execution_sha","execution_surface_sha256","gate2a_receipt_sha256","accepted_audio","environment","environment_post","runtime","artifact_authentication","sessions","soak","resources","resource_observations","cleanup","log_hygiene","partial_trace","p_results","violations","result","publication_status"],
  "properties":{
    "packet_id":{"const":"G2B-PI-COMBINED-001"},
    "run_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "candidate_id":{"enum":["UNKNOWN","CAND-LRT-G4E2B-MOBILE-R1","CAND-LRT-Q25-15B-Q8-R1"]},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "execution_surface_sha256":{"type":"string","pattern":"^$|^[0-9a-f]{64}$"},
    "gate2a_receipt_sha256":{"type":"string","pattern":"^$|^[0-9a-f]{64}$"},
    "accepted_audio":{"type":"object"},"environment":{"type":"object"},
    "environment_post":{"type":"object"},"runtime":{"type":"object"},
    "artifact_authentication":{"type":"object"},
    "sessions":{"type":"array","maxItems":20},
    "soak":{"type":"object"},"resources":{"type":"object"},"resource_observations":{"type":"object"},
    "cleanup":{"type":"object"},
    "log_hygiene":{"type":"object"},"partial_trace":{"type":"array","maxItems":20},
    "p_results":{"type":"object","additionalProperties":false,"required":["P9","P10B"],"properties":{"P9":{"enum":["PASS","FAIL","Blocked"]},"P10B":{"enum":["PASS","FAIL","Blocked"]}}},
    "violations":{"type":"array","items":{"type":"string"}},
    "result":{"enum":["PASS","FAIL","INCONCLUSIVE"]},
    "publication_status":{"const":"REVIEW_REQUIRED"}
  },
  "allOf":[
    {
      "if":{"properties":{"result":{"const":"PASS"}}},
      "then":{
        "properties":{
          "candidate_id":{"enum":["CAND-LRT-G4E2B-MOBILE-R1","CAND-LRT-Q25-15B-Q8-R1"]},
          "accepted_audio":{"$ref":"#/$defs/accepted_audio_pass"},
          "artifact_authentication":{"$ref":"#/$defs/artifact_auth_pass"},
          "sessions":{"minItems":20,"maxItems":20,"uniqueItems":true,"items":{"$ref":"#/$defs/session"}},
          "soak":{
            "type":"object","additionalProperties":false,
            "required":["cadence_seconds","pause_count","pause_elapsed_ms","total_elapsed_ms"],
            "properties":{
              "cadence_seconds":{"const":5.0},"pause_count":{"const":19},
              "pause_elapsed_ms":{"type":"array","minItems":19,"maxItems":19,"items":{"type":"number","minimum":5000}},
              "total_elapsed_ms":{"type":"number","minimum":95000}
            }
          },
          "resources":{"$ref":"#/$defs/resources_pass"},
          "resource_observations":{"type":"object","additionalProperties":false,"required":["continuous_samples","session_points","oom_before","oom_after"],"properties":{"continuous_samples":{"type":"array","minItems":2,"items":{"allOf":[{"$ref":"#/$defs/resource_sample"},{"required":["collection_duration_s"]}]}},"session_points":{"type":"array","minItems":20,"maxItems":20,"items":{"allOf":[{"$ref":"#/$defs/resource_sample"},{"required":["session_index"]}]}},"oom_before":{"type":"integer","minimum":0},"oom_after":{"type":"integer","minimum":0}}},
          "cleanup":{"$ref":"#/$defs/cleanup_pass"},
          "log_hygiene":{"$ref":"#/$defs/log_scan"},
          "partial_trace":{"maxItems":0},
          "p_results":{"properties":{"P9":{"const":"PASS"},"P10B":{"const":"PASS"}}},
          "violations":{"maxItems":0}
        }
      }
    },
    {
      "if":{"properties":{"result":{"const":"FAIL"}}},
      "then":{"properties":{"p_results":{"anyOf":[{"properties":{"P9":{"const":"FAIL"}}},{"properties":{"P10B":{"const":"FAIL"}}}]}}}
    }
  ]
}
