{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:snowboard:llm-poc:gate2a:model-finalist-receipt:1.0",
  "type":"object","additionalProperties":false,
  "required":["receipt_version","packet_id","candidate_id","candidate_disposition","execution_sha","execution_surface_sha256","gate2a_lock_sha256","candidate_result_sha256","artifact_receipt_sha256","gate1_entry_sha256","p_results","p8_qualifier","selection","user_review","core_ack_id","core_ack_required_before_final_delivery","result"],
  "properties":{
    "receipt_version":{"const":"gate2a-model-finalist/1"},
    "packet_id":{"const":"G2A-PI-LLM-002"},
    "candidate_id":{"const":"CAND-LRT-G4E2B-MOBILE-R1"},
    "candidate_disposition":{"const":"USER_SELECTED_MODEL_FINALIST"},
    "execution_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "execution_surface_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gate2a_lock_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "candidate_result_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gate1_entry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "p_results":{
      "type":"object","additionalProperties":false,
      "required":["P1","P2","P3","P4","P5","P6.1","P7.1","P8","P10A","P11","P12"],
      "properties":{
        "P1":{"const":"PASS"},"P2":{"const":"FAIL"},"P3":{"const":"PASS"},
        "P4":{"const":"PASS"},"P5":{"const":"PASS"},"P6.1":{"const":"PASS"},
        "P7.1":{"const":"PASS"},"P8":{"const":"FAIL"},"P10A":{"const":"PASS"},
        "P11":{"const":"PASS"},"P12":{"const":"PASS"}
      }
    },
    "p8_qualifier":{"const":"DEPENDENCY_LIMITED_BY_P2"},
    "selection":{
      "type":"object","additionalProperties":false,
      "required":["decision","current_product_baseline","gate2b_pairing_revision","gate2b_product_config_sha256","scoring_policy"],
      "properties":{
        "decision":{"const":"ADVANCE_MODEL_ONLY"},
        "current_product_baseline":{"const":"REJECTED"},
        "gate2b_pairing_revision":{"const":"litert-lm-v0.16.0-pi-g2b-r1"},
        "gate2b_product_config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "scoring_policy":{"const":"FIRST_MODEL_CONTACT_IS_HELD_OUT_GATE2B"}
      }
    },
    "user_review":{
      "type":"object","additionalProperties":false,"required":["approved","review_id"],
      "properties":{
        "approved":{"const":true},
        "review_id":{"const":"ASSESSMENT-LLM-M3-GATE2A-20260829-USER-REVIEW"}
      }
    },
    "core_ack_id":{"type":["string","null"],"minLength":1},
    "core_ack_required_before_final_delivery":{"const":true},
    "result":{"const":"MODEL_FINALIST_SELECTED"}
  }
}
