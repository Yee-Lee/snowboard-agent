# Snowboard Environment Variables Example
#
# Copy this file to .env and fill in real values.
# Only explicitly mapped SBD_ keys are accepted; unknown SBD_ keys are rejected.
# Process env (os.environ) takes precedence over .env values.
# No shell expansion is performed.

SBD_LOG_LEVEL=INFO
SBD_MQTT_USERNAME=
SBD_MQTT_PASSWORD=
