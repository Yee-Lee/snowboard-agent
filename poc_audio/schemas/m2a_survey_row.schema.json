{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowboard.local/schemas/m2a_survey_row.schema.json",
  "title": "M2A Baseline Survey Sanitized Row",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "review_status",
    "poc_source_sha",
    "candidate_id",
    "artifact",
    "runtime",
    "method",
    "fixture_lock_sha256",
    "summary",
    "execution_status",
    "cleanup",
    "security",
    "results"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"const": "M4A-M2A-BASELINE-SURVEY-ROW-001"},
    "review_status": {"const": "UNREVIEWED"},
    "poc_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "fixture_lock_sha256": {"const": "fa3649f2fde77aaaa2132cab81b6d3c562e2b812335d90e846fb6c3f85c943e6"},
    "controlled_manifest_sha256": {"const": "24d3747cbcec7b5a22c7842ac92851a672dcdbe8b256e616c0abf1195dd42a9a"},
    "execution_status": {
      "enum": [
        "OBSERVATIONS_COMPLETE_PENDING_COMPARATIVE_REVIEW",
        "INCONCLUSIVE_RETAINED"
      ]
    },
    "artifact": {"type": "object"},
    "runtime": {"type": "object"},
    "method": {"type": "object"},
    "summary": {"type": "object"},
    "cleanup": {"type": "object"},
    "security": {
      "type": "object",
      "required": ["audio_device_opened", "speaker_playback", "pcm_emitted_to_report"],
      "properties": {
        "audio_device_opened": {"const": false},
        "speaker_playback": {"const": false},
        "pcm_emitted_to_report": {"const": false}
      }
    },
    "results": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "family",
          "category",
          "latency_ms",
          "rtf",
          "reference_length",
          "hypothesis_length",
          "edit_distance",
          "sentence_correct",
          "hypothesis_sha256"
        ],
        "not": {
          "anyOf": [
            {"required": ["reference_text"]},
            {"required": ["hypothesis"]},
            {"required": ["wav_path"]},
            {"required": ["relative_wav_path"]}
          ]
        }
      }
    }
  }
}
