    "schema_version": {"const": "1.0"},
    "manifest_id": {"const": "M4A-G1B-ASR-RECOVERY-ACK-002"},
    "ack_id": {"const": "DELIVERY-AUDIO-POC-M4A-G1B-ASR-RECOVERY-ACK-002"},
    "reviewed_poc": {"type": "object"},
    "status": {"const": "AUTHORIZED_NOT_EXECUTED"},
    "controlled_artifact_policy": {"type": "object"},
    "engine_source": {"type": "object"},
    "model_repository": {"type": "object"},
    "candidates": {"type": "array", "minItems": 2, "maxItems": 2},
    "execution_policy": {"type": "object"},
    "runtime_profile": {"type": "object"},
    "gates": {"type": "object"},
    "build_closure": {"type": "object"}
  }
}
