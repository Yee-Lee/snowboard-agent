{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:m4-failure-result:1.0",
  "title": "Audio POC M4 Failure Injection and Recovery Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "test_id", "publication_status", "audio_execution_sha", "core_execution_sha", "controlled_evidence", "cases", "cleanup", "proposed_disposition", "decision_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"const": "M4-COMBINED-VALIDATION-TEST-PACKET-001"},
    "test_id": {"const": "M4-FAILURE-INJECTION-RECOVERY-001"},
    "publication_status": {"const": "DRAFT_USER_CONFIRMATION_PENDING"},
    "cases": {"type": "array", "minItems": 12, "maxItems": 12},
    "proposed_disposition": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}
  }
}
