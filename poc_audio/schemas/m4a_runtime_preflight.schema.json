{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4a authorized runtime preflight report",
  "type": "object",
  "required": ["schema_version", "report_id", "generated_at_utc", "poc_source_sha", "core_gate1b_ack_commit", "poc_gate1b_proposal_commit", "candidate_ids", "network_policy", "platform", "verified_artifacts", "install", "runtime_identity", "execution_status", "cleanup"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"const": "M4A-G1B-AUTHORIZED-RUNTIME-PREFLIGHT"},
    "poc_source_sha": {"pattern": "^[0-9a-f]{40}$"},
    "candidate_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "network_policy": {"const": "offline_from_hashed_inputs"},
    "execution_status": {"const": "RUNTIME_IMPORT_PASS_NOT_INFERRED"},
    "cleanup": {"type": "object"}
  }
}
