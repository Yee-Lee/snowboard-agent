{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4a Matcha network-disabled report",
  "type": "object",
  "required": ["schema_version", "report_id", "generated_at_utc", "poc_source_sha", "candidate_id", "platform", "scope", "prompt_identity", "offline_run", "network_evidence", "security", "execution_status", "cleanup"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"const": "M4A-G1B-WP3-MATCHA-OFFLINE"},
    "poc_source_sha": {"pattern": "^[0-9a-f]{40}$"},
    "candidate_id": {"const": "tts-sherpa-matcha-zh-en-1.13.5"},
    "scope": {"const": "MATCHA_NETWORK_DISABLED_INFERENCE_NO_PLAYBACK"},
    "execution_status": {"enum": ["P12_PASS", "P12_FAIL_RETAINED"]}
  }
}
