{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:m4-combined-result:1.0",
  "title": "Audio POC M4 Combined Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "run_id", "run_mode", "evidence_eligible", "publication_status", "source_sha", "core_sha", "network_policy", "model_load_counts", "sessions", "failure_injections", "cleanup", "proposed_disposition", "decision_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"const": "M4-COMBINED-VALIDATION-TEST-PACKET-001"},
    "run_id": {"type": "string", "minLength": 1},
    "run_mode": {"enum": ["fake", "formal"]},
    "evidence_eligible": {"type": "boolean"},
    "publication_status": {"const": "DRAFT_USER_CONFIRMATION_PENDING"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "core_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "network_policy": {"type": "string"},
    "model_load_counts": {"type": "object"},
    "sessions": {"type": "array", "minItems": 20, "maxItems": 20},
    "failure_injections": {"type": "array", "minItems": 12, "maxItems": 12},
    "cleanup": {"type": "object"},
    "proposed_disposition": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_HARDWARE_EVIDENCE"]},
    "decision_boundary": {"type": "string", "minLength": 1}
  }
}
