{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/audio-poc/m3-qualification-result.schema.json",
  "title": "Audio POC M3 draft qualification result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "packet_id",
    "test_id",
    "publication_status",
    "result",
    "poc_execution_sha",
    "core_execution_sha",
    "command",
    "cleanup",
    "controlled_evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"const": "M3-RISK-FOCUSED-QUALIFICATION-TEST-PACKET-001"},
    "test_id": {"type": "string", "pattern": "^M3-"},
    "publication_status": {"const": "DRAFT_USER_CONFIRMATION_PENDING"},
    "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "poc_execution_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "core_execution_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_processes", "threads", "tasks", "iterators", "streams",
        "file_descriptors", "device_owners"
      ],
      "properties": {
        "child_processes": {"type": "integer", "minimum": 0},
        "threads": {"type": "integer", "minimum": 0},
        "tasks": {"type": "integer", "minimum": 0},
        "iterators": {"type": "integer", "minimum": 0},
        "streams": {"type": "integer", "minimum": 0},
        "file_descriptors": {"type": "integer", "minimum": 0},
        "device_owners": {"type": "integer", "minimum": 0}
      }
    },
    "controlled_evidence": {
      "type": "object",
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
