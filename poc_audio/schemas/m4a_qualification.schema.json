{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4a Gate 1B full qualification report",
  "type": "object",
  "required": ["schema_version", "report_id", "generated_at_utc", "poc_source_sha", "platform", "scope", "method", "input_identity", "network_evidence", "raw_runs", "summaries", "resources", "security", "pending", "execution_status", "cleanup"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"const": "M4A-G1B-WP3-FULL-QUALIFICATION"},
    "poc_source_sha": {"pattern": "^[0-9a-f]{40}$"},
    "scope": {"const": "AUTHORIZED_ASR_TTS_FULL_FIXTURE_QUALITY_RESOURCE_NO_PLAYBACK"},
    "execution_status": {"enum": ["QUALIFICATION_QUALITY_LATENCY_PASS_PENDING_RESOURCE_LIFECYCLE_USER_OFFLINE", "QUALIFICATION_QUALITY_LATENCY_FAIL_RETAINED", "QUALIFICATION_INCONCLUSIVE_RETAINED"]}
  }
}
