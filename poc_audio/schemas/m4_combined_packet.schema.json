{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:m4-combined-packet:1.0",
  "title": "Audio POC M4 Combined Validation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "status", "authority", "source", "fixtures", "pipeline", "candidates", "p9", "failure_injections", "timeouts_seconds", "publication_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"const": "M4-COMBINED-VALIDATION-TEST-PACKET-001"},
    "status": {"const": "USER_APPROVED_LOCAL_IMPLEMENTATION_AUTHORIZED"},
    "authority": {
      "type": "object",
      "required": ["p9_1_user_approval_date", "p9_1_design"],
      "properties": {
        "p9_1_user_approval_date": {"const": "2026-08-25"},
        "p9_1_design": {"const": "SEQUENTIAL_VAD_ASR_LLM_TTS_RESIDENCY"}
      }
    },
    "source": {"type": "object"},
    "fixtures": {
      "type": "object",
      "required": ["catalog_correction"],
      "properties": {
        "catalog_correction": {"const": "M4-P9.1-CATALOG-CORRECTION-001"}
      }
    },
    "pipeline": {"type": "object"},
    "candidates": {"type": "object"},
    "p9": {
      "type": "object",
      "required": ["test_id", "supersedes_test_id", "orchestration_policy", "controller_thread_policy"],
      "properties": {
        "test_id": {"const": "M4-P9.1-REALISTIC-TURN-RESIDENCY-001"},
        "supersedes_test_id": {"const": "M4-P9-RESIDENCY-001"},
        "orchestration_policy": {"const": "VAD_ASR_THEN_P9_INFER_THEN_REASONER_TTS"},
        "controller_thread_policy": {
          "const": {"OPENBLAS_NUM_THREADS": "1"}
        }
      }
    },
    "failure_injections": {"type": "array", "minItems": 12, "maxItems": 12},
    "timeouts_seconds": {"type": "object"},
    "publication_status": {"const": "DRAFT_USER_CONFIRMATION_PENDING"}
  }
}
