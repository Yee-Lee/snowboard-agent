{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:result:1.0",
  "title": "Audio POC Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "source_sha", "candidate_id",
    "candidate_kind", "scenario", "started_at_utc", "duration_ms",
    "terminal_status", "worker_exit_code", "error_code",
    "force_abort_used", "cleanup"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_kind": {"enum": ["fake", "vad", "asr", "tts"]},
    "scenario": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number", "minimum": 0},
    "terminal_status": {"enum": ["success", "error", "timeout", "cancelled", "force_aborted"]},
    "worker_exit_code": {"type": ["integer", "null"]},
    "error_code": {"type": ["string", "null"]},
    "force_abort_used": {"type": "boolean"},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_processes", "threads", "iterators", "streams", "device_owners", "clean"],
      "properties": {
        "child_processes": {"type": "integer", "minimum": 0},
        "threads": {"type": "integer", "minimum": 0},
        "iterators": {"type": "integer", "minimum": 0},
        "streams": {"type": "integer", "minimum": 0},
        "device_owners": {"type": "integer", "minimum": 0},
        "clean": {"type": "boolean"}
      }
    }
  }
}
