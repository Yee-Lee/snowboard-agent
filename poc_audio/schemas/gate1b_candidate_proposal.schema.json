{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:gate1b-candidate-proposal:1.0",
  "title": "Audio POC Gate 1B Exact Candidate Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "status",
    "language",
    "core_gate1a",
    "poc_binding",
    "controlled_artifact_policy",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "status": {"const": "PROPOSED_NOT_AUTHORIZED"},
    "language": {"const": "zh-TW"},
    "core_gate1a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_id", "branch", "commit", "path"],
      "properties": {
        "delivery_id": {"type": "string", "minLength": 1},
        "branch": {"const": "dev_agent_m4"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "poc_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "proposal_commit"],
      "properties": {
        "branch": {"const": "dev_audio_m2"},
        "proposal_commit": {"type": "null"}
      }
    },
    "controlled_artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_in_git",
        "locator_prefix",
        "permitted_actions",
        "prohibited_actions"
      ],
      "properties": {
        "tracked_in_git": {"const": false},
        "locator_prefix": {"type": "string", "pattern": "^controlled://"},
        "permitted_actions": {"type": "array", "items": {"type": "string"}},
        "prohibited_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "domain",
        "origin",
        "requested_disposition",
        "decision_reason",
        "engine",
        "artifacts",
        "dependencies",
        "aarch64_build_proposal",
        "native_contract",
        "offline_cache",
        "risks"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "domain": {"enum": ["vad", "asr", "tts"]},
        "origin": {"enum": ["core_baseline", "poc_alternative"]},
        "requested_disposition": {
          "enum": ["REQUEST_AUTHORIZE", "REQUEST_REJECT", "REQUEST_DEFER"]
        },
        "decision_reason": {"type": "string", "minLength": 1},
        "engine": {"$ref": "#/$defs/engine"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "runtime", "build", "native"],
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "runtime": {"type": "array", "items": {"type": "string"}},
            "build": {"type": "array", "items": {"type": "string"}},
            "native": {"type": "array", "items": {"type": "string"}}
          }
        },
        "aarch64_build_proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "status", "recipe", "network_policy"],
          "properties": {
            "platform": {"const": "Raspberry Pi 5 / Debian 13 / aarch64 / Python 3.13"},
            "status": {"const": "NOT_EXECUTED_GATE_1B"},
            "recipe": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "network_policy": {"const": "offline_from_hashed_inputs"}
          }
        },
        "native_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "input", "output"],
          "properties": {
            "status": {"const": "DECLARED_UNVERIFIED_GATE_1B"},
            "input": {"type": "string", "minLength": 1},
            "output": {"type": "string", "minLength": 1}
          }
        },
        "offline_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "locator"],
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "pattern": "^controlled://"}
          }
        },
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "upstream_url",
        "immutable_revision",
        "source_sha256",
        "source_size_bytes",
        "source_acquired_at_utc",
        "source_controlled_locator",
        "license",
        "notice"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "upstream_url": {"type": "string", "pattern": "^https://"},
        "immutable_revision": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_size_bytes": {"type": "integer", "minimum": 1},
        "source_acquired_at_utc": {"type": "string", "format": "date-time"},
        "source_controlled_locator": {"type": "string", "pattern": "^controlled://"},
        "license": {"type": "string", "minLength": 1},
        "notice": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "filename",
        "url",
        "immutable_revision",
        "sha256",
        "size_bytes",
        "acquired_at_utc",
        "license",
        "notice",
        "controlled_locator"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "immutable_revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "acquired_at_utc": {"type": "string", "format": "date-time"},
        "license": {"type": "string", "minLength": 1},
        "notice": {"type": "string", "minLength": 1},
        "controlled_locator": {"type": "string", "pattern": "^controlled://"}
      }
    }
  }
}
