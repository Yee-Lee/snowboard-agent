{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:option-a-validation-manifest:1.0",
  "title": "Audio POC M3 Option A Validation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "delivery_id", "test_packet_id", "poc_source_sha",
    "started_at_utc", "ended_at_utc", "hardware", "wiring",
    "sanitized_config", "runner", "fixture_generator", "candidate_provenance", "candidates",
    "tests", "reproduction_command"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "delivery_id": {"const": "DELIVERY-AUDIO-POC-M3-VALIDATION-001"},
    "test_packet_id": {"type": "string", "minLength": 1},
    "poc_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "hardware": {"type": "object"},
    "wiring": {"type": "object"},
    "sanitized_config": {"$ref": "#/$defs/artifact"},
    "runner": {"$ref": "#/$defs/artifact"},
    "fixture_generator": {"$ref": "#/$defs/artifact"},
    "candidate_provenance": {"$ref": "#/$defs/artifact"},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "tests": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status", "command", "raw_artifact_paths", "cleanup"],
        "properties": {
          "test_id": {"pattern": "^P4-A(0[1-9]|10)$"},
          "status": {"enum": ["Pending", "Blocked", "INCONCLUSIVE", "PASS", "FAIL"]},
          "command": {"type": ["string", "null"]},
          "raw_artifact_paths": {"type": "array", "items": {"type": "string"}},
          "cleanup": {"$ref": "#/$defs/cleanup"}
        }
      }
    },
    "reproduction_command": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "name", "version", "source_filename", "source_url", "source_sha256",
        "license", "license_file", "runtime_dependencies", "build_dependencies",
        "runtime_identity", "target_build_status"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_filename": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": "string", "minLength": 1},
        "license_file": {"type": "string", "minLength": 1},
        "runtime_dependencies": {"type": "array", "items": {"type": "string"}},
        "build_dependencies": {"type": "array", "items": {"type": "string"}},
        "runtime_identity": {"type": ["object", "null"]},
        "target_build_status": {"enum": ["Pending", "Blocked", "INCONCLUSIVE", "PASS", "FAIL"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "threads", "file_descriptors", "alsa_owners", "clean"],
      "properties": {
        "tasks": {"type": ["integer", "null"], "minimum": 0},
        "threads": {"type": ["integer", "null"], "minimum": 0},
        "file_descriptors": {"type": ["integer", "null"], "minimum": 0},
        "alsa_owners": {"type": ["integer", "null"], "minimum": 0},
        "clean": {"type": ["boolean", "null"]}
      }
    }
  }
}
