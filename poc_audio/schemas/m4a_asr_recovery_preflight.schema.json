{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M4a Gate 1B ACK-002 ASR recovery artifact preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at_utc",
    "poc_source_sha",
    "ack_id",
    "manifest_id",
    "candidate_id",
    "fallback_reason",
    "verified_files",
    "verified_notices",
    "network_policy",
    "execution_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"const": "M4A-G1B-ASR-RECOVERY-ARTIFACT-PREFLIGHT"},
    "generated_at_utc": {"type": "string"},
    "poc_source_sha": {"pattern": "^[0-9a-f]{40}$"},
    "ack_id": {"const": "DELIVERY-AUDIO-POC-M4A-G1B-ASR-RECOVERY-ACK-002"},
    "manifest_id": {"const": "M4A-G1B-ASR-RECOVERY-ACK-002"},
    "candidate_id": {
      "enum": [
        "asr-whispercpp-small-q8_0-1.9.2",
        "asr-whispercpp-small-q5_1-1.9.2"
      ]
    },
    "fallback_reason": {"type": ["string", "null"]},
    "verified_files": {"type": "array", "minItems": 2, "maxItems": 2},
    "verified_notices": {"type": "array", "minItems": 3, "maxItems": 3},
    "network_policy": {"const": "offline_from_hashed_inputs"},
    "execution_status": {"const": "ARTIFACT_PREFLIGHT_PASS_BUILD_NOT_RUN"}
  }
}
