{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowboard:audio-poc:fixture-catalog:1.0",
  "title": "Audio POC Fixture Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "kind", "path", "sha256", "source", "license", "sensitivity"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["fake_vad_labels", "fake_asr_references", "fake_tts_prompts", "vad_audio", "asr_audio", "tts_prompts"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "sensitivity": {"enum": ["non_sensitive", "controlled", "private"]}
        }
      }
    }
  }
}
