{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/audio-poc/m3-core-signoff.schema.json",
  "title": "Audio POC M3 Core packet signoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "packet_id",
    "response_id",
    "poc_execution_sha",
    "core_execution_sha",
    "core_acceptance_sha",
    "packet_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "CORE_PACKET_SIGNED_OFF"},
    "packet_id": {"const": "M3-RISK-FOCUSED-QUALIFICATION-TEST-PACKET-001"},
    "response_id": {"type": "string", "minLength": 1},
    "poc_execution_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "core_execution_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "core_acceptance_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "packet_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
