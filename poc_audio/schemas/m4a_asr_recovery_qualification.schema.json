    "platform": {"type": "object"},
    "artifact_preflight": {"type": "object"},
    "build_identity": {"type": "object"},
    "method": {"type": "object"},
    "input_identity": {"type": "object"},
    "raw_runs": {"type": "object"},
    "summary": {"type": "object"},
    "quality": {"type": "object"},
    "performance": {"type": "object"},
    "thermal": {"type": "object"},
    "network_evidence": {
      "const": "ISOLATED_NETWORK_NAMESPACE_NO_ROUTE_OR_ACTIVE_INTERFACE_BEFORE_AND_AFTER_QUALIFICATION"
