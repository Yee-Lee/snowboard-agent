    "report_id": {"const": "M4A-G1B-ASR-RECOVERY-QUALIFICATION"},
    "generated_at_utc": {"type": "string"},
    "review_status": {"enum": ["UNREVIEWED", "REVIEWED"]},
    "poc_source_sha": {"pattern": "^[0-9a-f]{40}$"},
    "candidate_id": {
