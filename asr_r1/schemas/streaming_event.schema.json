{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowboard.local/asr-r1/streaming-event-v1.schema.json",
  "title": "AR1 Streaming Transcript Event",
  "type": "object",
  "required": ["schema_version", "kind", "session_id", "sequence", "emitted_at_ms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["partial", "final", "error"]},
    "session_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "emitted_at_ms": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1},
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "rank"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "invalid_state",
            "invalid_chunk",
            "out_of_order",
            "session_not_found",
            "cancelled",
            "shutdown"
          ]
        },
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "error"}}},
      "then": {"required": ["error"], "not": {"required": ["text"]}},
      "else": {"required": ["text"], "not": {"required": ["error"]}}
    }
  ],
  "additionalProperties": false
}
